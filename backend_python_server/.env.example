ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-run
APP_BASE_URL=http://localhost:8000
REQUIRE_EMAIL_VERIFICATION=1
EMAIL_VERIFICATION_EXPIRE_HOURS=24
EMAIL_VERIFICATION_RETURN_LINK=0
PASSWORD_RESET_EXPIRE_MINUTES=30
PASSWORD_RESET_RETURN_LINK=0
BCRYPT_ROUNDS=10

# Production email delivery. Configure one provider so signup verification and
# password reset links are emailed instead of exposed in the browser.
EMAIL_FROM=no-reply@jazzai.online
EMAIL_FROM_NAME=JAZZ AI
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1
SMTP_USE_SSL=0

# Supabase stays public/verification-scoped only. JAZZ auth, JWT sessions, OAuth,
# chat, files, and admin features continue to use the backend normally.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

GROQ_API_KEY=
HF_TOKEN=
NVIDIA_API_KEY=

JWT_SECRET_KEY=
FERNET_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

LIVY_URL=http://localhost:8998
LIVY_USER=
LIVY_PASSWORD=
